{
  "id": "xvideos",
  "name": "xVideos",
  "version": "1.1.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Búsqueda precisa de xVideos (relevancia, HD/1080p, filtros de duración y fecha). Con descargas offline.",
  "author": "tu-usuario",
  "homepage": "https://github.com/tu-usuario/kino-plugin-xvideos",
  "hosts": [
    "xvideos.com",
    "www.xvideos.com",
    "*.xvideos.com"
  ],
  "capabilities": ["search", "home", "browse", "resolve", "download"],
  "categories": ["adult"],
  "color": "#C41E3A",
  "streamHosts": "any",
  "settings": [
    {
      "key": "searchSection",
      "label": "Búsqueda",
      "type": "section",
      "hint": "Cómo se ordenan y filtran los resultados"
    },
    {
      "key": "sort",
      "label": "Ordenar por",
      "type": "select",
      "default": "relevance",
      "options": [
        { "value": "relevance", "label": "Relevancia (más preciso)" },
        { "value": "uploaddate", "label": "Más recientes" },
        { "value": "rating", "label": "Mejor valorados" },
        { "value": "views", "label": "Más vistos" },
        { "value": "length", "label": "Duración" }
      ]
    },
    {
      "key": "quality",
      "label": "Calidad mínima",
      "type": "select",
      "default": "hd",
      "hint": "Filtra en la búsqueda de xVideos",
      "options": [
        { "value": "all", "label": "Cualquiera" },
        { "value": "hd", "label": "HD o superior" },
        { "value": "1080P", "label": "Solo 1080p+" }
      ]
    },
    {
      "key": "durf",
      "label": "Duración",
      "type": "select",
      "default": "allduration",
      "options": [
        { "value": "allduration", "label": "Cualquiera" },
        { "value": "1-3min", "label": "1–3 min" },
        { "value": "3-10min", "label": "3–10 min" },
        { "value": "10-20min", "label": "10–20 min" },
        { "value": "10min_more", "label": "Más de 10 min" },
        { "value": "20min_more", "label": "Más de 20 min" }
      ]
    },
    {
      "key": "datef",
      "label": "Fecha de subida",
      "type": "select",
      "default": "all",
      "options": [
        { "value": "all", "label": "Cualquiera" },
        { "value": "today", "label": "Hoy" },
        { "value": "week", "label": "Esta semana" },
        { "value": "month", "label": "Este mes" },
        { "value": "3month", "label": "Últimos 3 meses" },
        { "value": "6month", "label": "Últimos 6 meses" }
      ]
    },
    {
      "key": "playSection",
      "label": "Reproducción y descarga",
      "type": "section",
      "hint": "Qué calidad preferir al reproducir o descargar"
    },
    {
      "key": "preferQuality",
      "label": "Calidad preferida al reproducir",
      "type": "select",
      "default": "high",
      "options": [
        { "value": "high", "label": "MP4 Alta (recomendado)" },
        { "value": "hls", "label": "HLS (adaptable)" },
        { "value": "low", "label": "MP4 Baja (ahorra datos)" }
      ]
    },
    {
      "key": "resultsPerPage",
      "label": "Resultados por página",
      "type": "select",
      "default": "30",
      "hint": "xVideos muestra ~27–30; esto solo afecta el tope que guardamos",
      "options": [
        { "value": "15", "label": "15" },
        { "value": "30", "label": "30" },
        { "value": "50", "label": "50" }
      ]
    }
  ]
}
